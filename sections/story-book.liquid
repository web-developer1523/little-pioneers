           {
             breakpoint: 767,
             settings: {
               arrows: false,

               slidesToShow: 1
             }
           },
           {
             breakpoint: 595,
             settings: {
               arrows: false,

               slidesToShow: 1
             }
           }
         ]
       });
    });
</script>

{% schema %}
{
  "name": "Story book",
  "settings": [
    {
      "type": "text",
      "id": "custom-css",
      "label": "Custom Css"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "front cover"
    },
    {
      "type": "image_picker",
      "id": "end_cover_image",
      "label": "Back cover"
    }
  ],
  "blocks":[
    {
      "type": "book-page",
      "name": "book page",
      "settings": [
        {
          "type": "text",
          "id":"chapter-heading",
          "label":"Chapter Heading"
        },
        {
          "type": "inline_richtext",
          "id":"book-text",
          "label": "Book text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Book image"
        }

      ]
    }
  ],
  "presets": [
    {
      "name":"Story book"
    }
  ]
}
{% endschema %}
