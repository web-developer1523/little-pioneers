      /*-----------------------------------------------------------------*/
    // JavaScript
  const pages = document.querySelectorAll('.pages > *');
  pages.forEach((page, i) => {
    if (i % 2 === 0) {
      page.style.zIndex = pages.length - i;
    }
  });

  let currentIndex = 0;
  let flipInterval = null; // To store the interval reference

  // Function to start the automatic page flipping
  function startAutoFlip() {
    // Avoid starting multiple intervals
    if (!flipInterval) {
      flipInterval = setInterval(autoFlip, 1500);
    }
  }

  // Function to stop the automatic page flipping
  function stopAutoFlip() {
    if (flipInterval) {
      clearInterval(flipInterval);
      flipInterval = null;
    }
  }

  function autoFlip() {
    if (currentIndex < pages.length - 1) {
      const page = pages[currentIndex];
      const nextPage = pages[currentIndex + 1];
      page.classList.add('flipped');
      if (nextPage) nextPage.classList.add('flipped');
      currentIndex += 2;
    } else {
      // Reset book when last page is reached
      pages.forEach(page => page.classList.remove('flipped'));
      currentIndex = 0;
    }
  }

  // Manual navigation: move to the next two pages
  function nextPage() {
    stopAutoFlip();
    if (currentIndex < pages.length - 1) {
      const page = pages[currentIndex];
      const nextPageElem = pages[currentIndex + 1];
      page.classList.add('flipped');
      if (nextPageElem) nextPageElem.classList.add('flipped');
      currentIndex += 2;
    }
  }

  // Manual navigation: go back two pages
  function previousPage() {
    stopAutoFlip();
    if (currentIndex > 0) {
      currentIndex -= 2;
      const page = pages[currentIndex];
      const nextPageElem = pages[currentIndex + 1];
      page.classList.remove('flipped');
      if (nextPageElem) nextPageElem.classList.remove('flipped');
    }
  }

  // Start automatic page flipping on load
  startAutoFlip();

  // Stop automatic flipping when cursor is on any page
  pages.forEach(page => {
    page.addEventListener('mouseover', stopAutoFlip);
    page.addEventListener('mouseout', startAutoFlip);
  });

  // Add event listeners for the manual buttons
  document.getElementById('nextBtn').addEventListener('click', nextPage);
  document.getElementById('prevBtn').addEventListener('click', previousPage);

  // Adjust layout for small screens
  function adjustLayout() {
    const isSmallScreen = window.matchMedia("(max-width: 768px)").matches;
    if (isSmallScreen) {
      pages.forEach(page => page.classList.remove('flipped'));
    }
  }

  window.addEventListener('load', adjustLayout);
  window.addEventListener('resize', adjustLayout);

  // Add 'bound' class to book element
  document.querySelector('.book')?.classList.add('bound');

  //---------------------------------------------------------------------
          // slider code
    $(document).ready(function(){
      $('.page-slider').slick({
