<section class="book bound 2">
  <article class="pages">
    <!-- Spread 1: Cover -->
    <img
      id="page-cover"
      class="page"
      src="{{ section.settings.cover_image | img_url: 'master' }}"
      alt="Book cover"
    >

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'book-page' %}
          <div id="page-{{ forloop.index }}" class="page">
            <h2 class="cst-common-head">{{ block.settings['chapter-heading'] }}</h2>
            <p>{{ block.settings['book-text'] }}</p>
          </div>
          <img
            src="{{ block.settings.image | img_url: 'master' }}"
            alt="Page 1"
            id="page-{{ forloop.index }}"
            class="page"
          >
      {% endcase %}
    {% endfor %}
    <!--
