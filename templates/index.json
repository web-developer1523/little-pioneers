            "row_content": "<ul><li><strong>Standard  Delivery </strong>$15 per purchase</li><li><strong>Free Standard Delivery </strong>for orders over <strong>$95</strong></li><li><strong>Express Delivery </strong>$25 per purchase </li></ul>",
